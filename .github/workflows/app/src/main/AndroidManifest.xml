<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Serve per poter vedere se le app FM del produttore sono installate (Android 11+) -->
    <queries>
        <package android:name="com.sec.android.app.fm" />
        <package android:name="com.samsung.android.app.fm" />
        <package android:name="com.caf.fmradio" />
        <package android:name="com.android.fmradio" />
        <package android:name="com.mediatek.fmradio" />
        <package android:name="com.miui.fm" />
    </queries>

    <application
        android:label="FM RDS"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
